# ~/.config/sxwmrc
# Converted from an sxwm-conf config. sxwm is much simpler than i3 — see the notes
# at the bottom of this file for things sxwm-conf could do that sxwm can't.

# ---------------------------------------------------------------------------
# GENERAL OPTIONS
# ---------------------------------------------------------------------------
mod_key                 : $mod
gaps                     : 6
border_width             : 0
focused_border_colour    : #e2d2ab
unfocused_border_colour  : #8d846f
swap_border_colour       : #fff4c0
master_width             : 50
new_win_focus            : true
warp_cursor              : true
floating_on_top          : true
new_win_master           : false

# Windows that should always float (from your for_window floating rules)
should_float             : "dtop", "tk", "xdm-app", "Xdm-app", "localsend", "galculator"

# Terminal swallowing (roughly mirrors your btop/mpv floating-terminal setup)
can_swallow              : st
can_be_swallowed         : mpv, btop

# ---------------------------------------------------------------------------
# STARTUP (was your `exec` / `exec_always` block)
# ---------------------------------------------------------------------------
exec : "xsetroot -cursor_name left_ptr &"
exec : "env GTK_THEME=Adwaita:dark &"
exec : "xclip &"
exec : "rsxiv -B $HOME/.config/Wallpaper/Wallpaper"
exec : "bash $HOME/.config/sxwm-conf/autostart"

# ---------------------------------------------------------------------------
# MEDIA / BRIGHTNESS KEYS
# ---------------------------------------------------------------------------
bind : XF86AudioRaiseVolume       : "bash $HOME/.dotfiles/sxwm-conf/scripts/volume_raise"
bind : shift + XF86AudioRaiseVolume : "pactl set-sink-volume @DEFAULT_SINK@ 140%"
bind : XF86AudioLowerVolume       : "pactl set-sink-volume @DEFAULT_SINK@ -10%"
bind : XF86MonBrightnessUp        : "brightnessctl set +10%"
bind : XF86MonBrightnessDown      : "brightnessctl set 10%-"
bind : XF86AudioMute              : "pactl set-sink-mute @DEFAULT_SINK@ toggle"
bind : XF86AudioMicMute           : "pactl set-source-mute @DEFAULT_SOURCE@ toggle"

# ---------------------------------------------------------------------------
# CUSTOM SCRIPTS / LAUNCHERS
# ---------------------------------------------------------------------------
bind : $mod + shift + p    : "bash $HOME/.config/sxwm-conf/scripts/rofi/powerrofi"
bind : $mod + r            : "bash $HOME/.config/sxwm-conf/scripts/nightlight"
bind : $mod + shift + m    : "bash $HOME/.config/sxwm-conf/scripts/rofi/library"
bind : $mod + Return       : "st"

bind : $altmod + shift + c      : "px"
bind : $altmod + shift + period : "bash $HOME/.config/sxwm-conf/scripts/rofi/stickerpicker"
bind : $altmod + Tab            : "rofi -show window"
bind : $mod + Tab              : "twsk"
bind : $altmod + comma          : "bash $HOME/.config/sxwm-conf/scripts/rofi/wallpaper"
bind : $altmod + g               : "bash $HOME/.config/sxwm-conf/scripts/rofi/gamelauncher"
bind : $mod + shift + b         : "bash $HOME/.config/sxwm-conf/scripts/rofi/bluetooth"
bind : $altmod + m               : "bash $HOME/.config/sxwm-conf/scripts/rofi/musicpicker"
bind : $altmod + p               : "bash $HOME/.config/sxwm-conf/scripts/rofi/powermenu"
bind : $altmod + period          : "bash $HOME/.config/sxwm-conf/scripts/rofi/emojipicker"
bind : $altmod + r               : "bash $HOME/.config/sxwm-conf/scripts/rofi/screenrecorder"
bind : $mod + shift + t         : "bash $HOME/.config/sxwm-conf/scripts/rofi/timer"
bind : $altmod + s               : "bash $HOME/.config/sxwm-conf/scripts/empty_workspace"
bind : $altmod + shift + w       : "bash $HOME/.config/sxwm-conf/scripts/recog.sh"
bind : $altmod + v               : "rofi -modi 'clipboard:greenclip print' -show clipboard -run-command '{cmd}'"
bind : $altmod + u               : "bash $HOME/.config/sxwm-conf/scripts/rofi/urlman"
bind : $altmod + slash           : "bash $HOME/.config/sxwm-conf/scripts/rofi/cmd"
bind : $altmod + shift + u       : "sh $HOME/.config/sxwm-conf/scripts/rofi/urlsurf"
bind : $altmod + y               : "sh $HOME/.dotfiles/sxwm-conf/scripts/rofi/yt"

bind : $altmod + l : "lock"
bind : $altmod + e : "rdfm"
bind : $altmod + w : "chromium-bin"

bind : $mod + p          : "bash $HOME/.dotfiles/sxwm-conf/scripts/browser http://localhost:3000"
bind : $altmod + i        : "bash $HOME/.dotfiles/sxwm-conf/scripts/browser https://instagram.com"
bind : $altmod + f        : "bash $HOME/.dotfiles/sxwm-conf/scripts/browser https://messenger.com"
bind : $altmod + shift + m : "bash $HOME/.dotfiles/sxwm-conf/scripts/browser https://open.spotify.com"

bind : $altmod + shift + s : "shot"
bind : $mod + space        : "rofi -show drun"

bind : ctrl + shift + Escape : "st -t btop -c btop -e btop"
# ---------------------------------------------------------------------------
# WINDOW / FOCUS MANAGEMENT
# ---------------------------------------------------------------------------
bind : $mod + l  : focus_next
bind : $mod + h    : focus_prev

bind : $mod + shift + h : move_win_left
bind : $mod + shift + j : move_win_down
bind : $mod + shift + k : move_win_up
bind : $mod + shift + l : move_win_right

bind : $mod + f       : fullscreen
bind : $mod + w       : toggle_monocle
bind : $mod + t       : toggle_floating
bind : $mod + shift + q : close_window
bind : $mod + shift + r : reload_config

bind : $mod + bracketleft  : switch_previous_workspace
bind : $mod + bracketright : switch_previous_workspace

# ---------------------------------------------------------------------------
# WORKSPACES
# (sxwm workspaces are numbered only — named workspaces aren't supported)
# ---------------------------------------------------------------------------
workspace : $mod + 1 : move 1
workspace : $mod + 2 : move 2
workspace : $mod + 3 : move 3
workspace : $mod + 4 : move 4
workspace : $mod + 5 : move 5
workspace : $mod + 6 : move 6
workspace : $mod + 7 : move 7
workspace : $mod + 8 : move 8
workspace : $mod + 9 : move 9
workspace : $mod + 0 : move 10

workspace : $mod + shift + 1 : swap 1
workspace : $mod + shift + 2 : swap 2
workspace : $mod + shift + 3 : swap 3
workspace : $mod + shift + 4 : swap 4
workspace : $mod + shift + 5 : swap 5
workspace : $mod + shift + 6 : swap 6
workspace : $mod + shift + 7 : swap 7
workspace : $mod + shift + 8 : swap 8
workspace : $mod + shift + 9 : swap 9
workspace : $mod + shift + 0 : swap 10

bind : $mod + b : "firefox"
